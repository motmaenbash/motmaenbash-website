extends ../layout/base.pug

block variables
  - var t = changelog
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    h1.text-center.mb-3= t.heading

    .row.justify-content-center
      .col-12
          ul.nav.nav-tabs.d-flex.flex-wrap.gap-2.mb-3(role="tablist")
            each tab, index in t.tabs
              li.nav-item
                a.btn.btn-blue(href="#" + tab.id data-bs-toggle="tab" class=index === 0 ? "active" : false)= tab.label

    .tab-content
      each tab, index in t.tabs
        .tab-pane.fade(id=tab.id class=index === 0 ? "show active" : false)
          each release in tab.releases
            .card.mb-3
              .card-body
                h5.fw-bold.mb-2.d-flex.align-items-center.flex-wrap.gap-2
                  span= release.version
                  if release.badge
                    span.badge.bg-info.text-white.fs-6= release.badge
                ul
                  each item in release.items
                    li= item
