doctype html
html(lang="fa" dir="rtl")
  head
    title صفحه پیدا نشد | مطمئن باش
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="robots" content="noindex, nofollow")
    link(rel="icon" type="image/png" href="/images/shield-bg.png")
    link(rel="stylesheet" href="/css/bootstrap.rtl.min.css?v=v5.3.3")
    link(rel="stylesheet" href="/css/style.css?v=1.0.12")
    style.
      body.page-404 {
        padding-top: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .page-404 .code {
        color: #111;
        font-size: 6rem;
        font-weight: 800;
        line-height: 0.9;
        letter-spacing: -0.04em;
      }
  body.page-404
    main.text-center.px-3
      p.code.mb-2(dir="ltr") 404
      h1.h4.mb-3 این صفحه پیدا نشد
      p.mb-4 آدرسی که باز کرده‌اید وجود ندارد، یا صفحه جابه‌جا شده است.
      a.btn.btn-blue(href="/") بازگشت به صفحه اصلی
