extends ../layout/base.pug

block variables
  - var t = about
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    h1.text-center.mb-4= t.heading

    .row
      div
        p.lead.text-center
          if t.leadStrong
            strong.fw-bold= t.leadStrong
          | #{t.lead}

        .card.mt-4
          .card-body
            h2.card-title= t.developerTitle
            p.card-text
              = t.developerBefore
              a(href="https://milad.nu" target="_blank"): strong= t.developerName
              = t.developerAfter
            each paragraph in t.developerParagraphs
              p.card-text= paragraph
            a.btn.btn-outline-primary.mt-2(href=t.gitHref)= t.gitLabel

        .card.mt-4
          .card-body
            h2.card-title= t.goalsTitle
            ul.list-unstyled
              each goal in t.goals
                li
                  i.fas.fa-check-double.text-success.me-1
                  |  #{goal}

        .card.mt-4
          .card-body
            h2.card-title= t.featuresTitle
            ul.list-unstyled
              each feature in t.features
                li
                  i.fas.fa-check-double.text-success.me-1
                  |  #{feature}

        .card.mt-4
          .card-body
            h2.card-title= t.contactTitle
            p.card-text
              | #{t.contactIntro}
              br
              strong= t.email
            p.card-text
              = t.contactFollow
              each social, index in t.socials
                if index
                  |  / 
                a(href=social.href target="_blank")= social.label

  section#donate.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    .donate.text-center
      h2.title-bg= t.donateTitle
      p= t.donateText
      a.btn.btn-warning(href="/donate.html" target=t.donateBlank ? "_blank" : false)= t.donateLabel
