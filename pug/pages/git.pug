extends ../layout/base.pug

block variables
  - var t = git
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    h1.text-center.mb-4= t.heading

    .row
      div
        p.lead.text-center= t.lead

        each repo in t.repos
          .card.mt-4
            .card-body
              h3.card-title
                i.text-gray.me-1(class=repo.icon)
                | #{repo.title}
              h5= repo.license
              p.card-text
                i.fab.fa-github.text-gray.me-1
                | #{t.githubLabel}
                |  
                a(href=repo.href target="_blank")= repo.href
              if repo.notes
                p.fs-6
                  each note, index in repo.notes
                    if index
                      br
                    | #{note}

  section#donate.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    .donate.text-center
      h2.title-bg= t.donateTitle
      p= t.donateText
      a.btn.btn-warning(href="/donate.html")= t.donateLabel
