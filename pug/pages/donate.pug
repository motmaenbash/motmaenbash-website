extends ../layout/base.pug

block variables
  - var t = donate
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    h1.text-center.mb-4= t.heading

    .row
      div
        p.lead.text-center
          | #{t.lead}
          br
          | #{t.project}

        .alert.alert-warning.mt-4.text-center
          | #{t.small} 
          i.fas.fa-heart
        .card.mt-4
          .card-body
            h3.card-title
              i.fas.fa-coins.text-gray.me-1
              | #{t.rialTitle}
            p.card-text.mt-3
              i.fas.fa-link.text-gray.me-1
              | #{t.coffeeteLabel}
              br
              a(href="https://coffeete.ir/miladnu" target="_blank") https://coffeete.ir/miladnu
              p.fs-6= t.rialNote

        .card.mt-4
          .card-body
            h3.card-title
              i.fas.fa-money-check-dollar.text-gray.me-1
              | #{t.dollarTitle}
            p.card-text.mt-3
              i.fas.fa-link.text-gray.me-1
              | #{t.coffeeLabel}
              br
              a(href="https://buymeacoffee.com/miladnu" target="_blank") https://buymeacoffee.com/miladnu

            hr
            p.card-text.mt-3
              i.fas.fa-link.text-gray.me-1
              | #{t.paypalLabel}
              br
              a(href="https://paypal.me/miladnu" target="_blank") https://paypal.me/miladnu

        .card.mt-4
          .card-body
            h3.card-title
              i.fas.fa-sack-dollar.text-gray.me-1
              | #{t.cryptoTitle}
            h6.mb-3= t.cryptoLead

            .d-flex.align-items-center.mb-4.gap-3.flex-wrap
              img(src="/images/qr/usdt.jpg" alt="Tether QR" width="100")
              div
                i.fas.fa-wallet.text-gray.me-1
                | #{t.usdt}
                br
                code(style="word-break: break-all") TCaBC8d9KhhEA9u5yKSqNSyf2DGFzKrBa2

            .d-flex.align-items-center.mb-4.gap-3.flex-wrap
              img(src="/images/qr/ton.jpg" alt="TON QR" width="100")
              div
                i.fas.fa-wallet.text-gray.me-1
                | #{t.ton}
                br
                code(style="word-break: break-all") UQDebT8tDixx34yeeNJ17aZQgmSpuyVJm6CUQ1gVQqcigHKN

            .d-flex.align-items-center.mb-4.gap-3.flex-wrap
              img(src="/images/qr/doge.jpg" alt="Doge QR" width="100")
              div
                i.fas.fa-wallet.text-gray.me-1
                | #{t.doge}
                br
                code(style="word-break: break-all") DEtm2jgDXJxztfbU2TcMgZbV2Wz3DhDzKr

            .d-flex.align-items-center.mb-4.gap-3.flex-wrap
              img(src="/images/qr/btc.jpg" alt="Bitcoin QR" width="100")
              div
                i.fab.fa-bitcoin.text-gray.me-1
                | #{t.btc}
                br
                code(style="word-break: break-all") bc1qaduh2ydcezca5hl8tv82x8ygylmqsrxct7wxzs

            .d-flex.align-items-center.mb-4.gap-3.flex-wrap
              img(src="/images/qr/eth.jpg" alt="Ethereum QR" width="100")
              div
                i.fab.fa-ethereum.text-gray.me-1
                | #{t.eth}
                br
                code(style="word-break: break-all") 0x04D283bcd8A1299f0f4bff35236090aaa1605Fd3

        .card.mt-4
          .card-body
            h3.card-title
              i.fab.fa-telegram.text-gray.me-1
              | #{t.starsTitle}
            h6= t.starsLead
            p.card-text
              i.fas.fa-link.text-gray.me-1
              | #{t.telegramLabel}
              a(href="https://t.me/miladnourichannel" target="_blank") @MiladNouriChannel

        .alert.alert-warning.mt-4.text-center
          | #{t.thanks} 
          i.fas.fa-heart
