include ../layout/inc_mixins.pug

- var t = home
- var title = t.title
- var description = t.description
- var keywords = t.keywords
- var url = t.url
- var lang = t.lang
- var locale = t.locale
- var alternateUrl = t.alternateUrl
- var alternateLang = t.alternateLang
- var includeSoftware = true
- var softwareAndroidName = t.softwareAndroidName
- var softwareExtensionName = t.softwareExtensionName
- var softwareAndroidInstall = t.softwareAndroidInstall
- var softwareExtensionInstall = t.softwareExtensionInstall

doctype html
html(lang=lang dir=dir)
  head
    include ../layout/inc_head

  body
    include ../layout/inc_header

    // Hero Section
    section.hero-section(dir=t.contentDir || false)
      canvas(id="hero-bg")
      .hero-overlay
      .hero-content
        img.logo.mb-2(src="/images/shield-tr.png" alt=t.hero.logoAlt)
        h1(title=t.hero.titleAttr)= t.hero.title
        h2= t.hero.subtitle

        .mt-5.mb-3= t.hero.share

        p.social-share
          a.mx-2(target="_blank" href=t.hero.shareWhatsapp title="Share on Whatsapp" aria-label=t.hero.whatsapp)
            i.fab.fa-whatsapp.fs-1
          a.mx-2(target="_blank" href=t.hero.shareTwitter title="Share on Twitter" aria-label=t.hero.twitter)
            i.fab.fa-twitter.fs-1
          a.mx-2(target="_blank" href=t.hero.shareTelegram title="Share on Telegram" aria-label=t.hero.telegram)
            i.fab.fa-telegram.fs-1
          a.mx-2(target="_blank" href=t.hero.shareLinkedin title="Share on LinkedIn" aria-label=t.hero.linkedin)
            i.fab.fa-linkedin.fs-1

        .pt-3
          a.btn.fs-5.m-2(href="#android-app")
            | #{t.hero.installApp} 
            b= t.hero.brand
          a.btn.fs-5.m-2(href="#download")
            | #{t.hero.installExtension} 
            b= t.hero.brand

        .pt-3
          a.btn.fs-6.m-2(href="#trust")
            | #{t.hero.trustBefore} 
            b= t.hero.trustBrand
            |  #{t.hero.trustAfter}

    section.container.my-2#trust(class=t.sectionClass || false dir=t.contentDir || false)
      h2.title-bg.d-flex.align-items-center.mb-lg-4= t.trustTitle
      .trust-box.text-white.p-4.fs-6.rounded-4
        h4.text-white.mb-3: strong= t.trustQuestion
        ul.list-unstyled.trust-list
          each item in t.trustItems
            li.mb-2
              i(class=item.icon)
              | #{item.text}
        a.btn.btn-blue.mt-3(href=t.trustMoreHref target="_blank")= t.trustMore

    section.container.my-2#android-app(class=t.sectionClass || false dir=t.contentDir || false)
      h2.title-bg.d-flex.align-items-center.mb-lg-4= t.androidTitle
      .row.align-items-start
        .col-md-6.mb-2
          .mb-4.fw-light.mt-3
            .d-flex.align-items-start
              img.app-icon.rounded-3.mb-2.me-3(src="/images/shield-bg.png" alt="Android App")
              div
                p
                  | #{t.androidLeadBefore}
                  b= t.hero.brand
                  | #{t.androidLeadAfter}
            ul.list-unstyled.mt-2.fs-6
              each feature in t.androidFeatures
                li
                  i.fas.fa-check-double.text-success.me-1
                  |  #{feature}
          .row.g-3.text-center
            .col-md-6
              a.btn.btn-blue.btn-platform.w-100(href="https://play.google.com/store/apps/details?id=nu.milad.motmaenbash" target="_blank" title=t.playTitle)
                .btn-platform-icon
                  img(src="/images/platforms/google-play.webp")
                .btn-platform-text= t.playLabel
            .col-md-6
              a.btn.btn-blue.btn-platform.w-100(href="https://cafebazaar.ir/app/nu.milad.motmaenbash" target="_blank" title=t.bazaarTitle)
                .btn-platform-icon
                  img(src="/images/platforms/bazzar.webp")
                .btn-platform-text= t.bazaarLabel
            .col-md-6
              a.btn.btn-blue.btn-platform.w-100(href="https://myket.ir/app/nu.milad.motmaenbash?utm_source=search-ads-gift&utm_medium=cpc" target="_blank" title=t.myketTitle)
                .btn-platform-icon
                  img(src="/images/platforms/myket.webp")
                .btn-platform-text= t.myketLabel
            .col-md-6
              a.btn.btn-platform.btn-platform-disabled.w-100(href="#" title=t.fdroidTitle)
                .btn-platform-icon
                  img(src="/images/platforms/f-droid.webp")
                .btn-platform-text= t.fdroidLabel

        .col-12.col-md-6
          .row
            each shot in t.screenshots
              .col
                img.screenshot(src=shot.src alt=shot.alt)

        .col-12
          .alert.alert-warning.mt-5.fs-6
            each warning, warningIndex in t.warnings
              i.fas.fa-triangle-exclamation.me-1
              |  #{warning}
              if warningIndex < t.warnings.length - 1
                br

    section.container.my-2#download(class=t.sectionClass || false dir=t.contentDir || false)
      h2.mb-4.text-center= t.extensionTitle
      p.text-center.text-muted.mb-5
        |  #{t.extensionLeadBefore}
        strong= t.hero.brand
        | #{t.extensionLeadAfter}
      .row.justify-content-center.g-4
        each browser in t.browsers
          .col-md-4
            .card.h-100.border-0.shadow-sm.position-relative
              .position-absolute.top-0.end-0.mt-2.me-2
                each badge in browser.badges
                  span.badge.me-1(class=badge.class)= badge.label
              .card-body.text-center
                img.w-25.mb-4(src=browser.image alt=browser.alt)
                h5= browser.name
                p.text-muted.fs-6= browser.text
                a.btn.btn-blue.mt-2(href=browser.href target="_blank")
                  i.fas.fa-download
                  |  #{browser.cta}

    section#whatsphishing.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
      h2.title-bg(title=t.phishingTitle)= t.phishingTitle
      .row
        .col-md-6
          each paragraph in t.phishingLead
            p.lh-lg.fw-light= paragraph
          p.lh-lg.fw-bold= t.phishingGoal
          ul.list-unstyled.fs-6
            each item in t.phishingTargets
              li
                i.fas.fa-triangle-exclamation.text-warning.me-1
                | #{item}
          p.lh-lg.fw-bold.mt-4= t.phishingMethodsTitle
          ul.list-unstyled.fs-6
            each item in t.phishingMethods
              li
                i.fas.fa-triangle-exclamation.text-warning.me-1
                | #{item}
          .alert.alert-warning.mt-4.fs-6
            i.fas.fa-triangle-exclamation.me-1
            | #{t.phishingAlert}

        - var accordionSeq = 0
        .col-md-6.accordion#faqAccordion
          each item in t.phishingItems
            +accordion-item(item.icon, item.title)
              each part in item.blocks
                if part.type == "text"
                  | #{part.text}
                else if part.type == "p"
                  p(class=part.class)= part.text
                else if part.type == "ul"
                  ul.list-unstyled
                    each line in part.items
                      li
                        i(class=part.icon)
                        if line.before
                          |  #{line.before}
                          span.text-success
                            i(class=line.icon)
                          | #{line.after}
                        else
                          |  #{line}

    include ../layout/inc_section_donate

    section#report.container.my-2.text-center(dir=t.contentDir || false)
      h2.title-bg.mb-4(title=t.reportTitle)= t.reportTitle
      p.lh-lg.fw-light
        | #{t.reportBefore}
        strong= t.reportBrand
        | #{t.reportAfter}
      a.btn.btn-blue(href="https://forms.gle/odNaY6jeks2eqZDZA" target="_blank" title=t.reportButton)= t.reportButton

    section#media.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
      h2.title-bg.text-center.mb-3(title=t.pressTitle)= t.pressTitle
      .row.media-logos.justify-content-center.align-content-center.text-center.g-4
        //- این بخش برای نمایش لوگوی رسانه‌های منتشرکننده افزونه مطمئن باش استفاده می‌شود
        .col-6.col-md-2
          a(href="https://nooshdaroo.ir/security-tools/motmaen-bash/" target="_blank")
            img.logo-width-120(src="/images/press/nooshdaroo-logo.jpg" alt=t.press[0])
        .col-6.col-md-2
          a(href="https://digiato.com/iran-technology-news/unveiling-android-app-motmaenbash" target="_blank")
            img(src="/images/press/digiato-logo.svg" alt=t.press[1])
        .col-6.col-md-2
          a(href="https://www.zoomit.ir/software-application/443587-motmaen-bash-milad-nouri-app-released-android/" target="_blank")
            img(src="/images/press/zoomit-logo.svg" alt=t.press[2])
        .col-6.col-md-2
          a(href="https://ana.ir/fa/news/984599/" target="_blank")
            img.logo-width-150(src="/images/press/ana-logo.svg" alt=t.press[3])
        .col-6.col-md-2
          a(href="https://ictna.ir/id/196908/" target="_blank")
            img.logo-width-150(src="/images/press/ictna-logo.png" alt=t.press[4])
        .col-6.col-md-2
          a(href="https://didgahnews.ir/%d9%86%d8%b1%d9%85%d8%a7%d9%81%d8%b2%d8%a7%d8%b1-%d8%a7%db%8c%d8%b1%d8%a7%d9%86%db%8c-%d9%85%d8%b7%d9%85%d8%a6%d9%86-%d8%a8%d8%a7%d8%b4-%d9%85%d8%b9%d8%b1%d9%81%db%8c-%d8%b4%d8%af/" target="_blank")
            img.logo-width-180(src="/images/press/didgahnews-logo.png" alt=t.press[5])
      p.text-center.mt-4.mb-0
        a.btn.btn-outline-primary(href=nav.prefix + "/press.html")= t.pressMore
      br
      p.text-center.fs-6.mb-4
        strong= t.hero.brand
        | #{t.pressBody}
        br
        | #{t.pressContact}
      .alert.alert-info.text-center.fs-6.mb-4
        | #{t.pressNoteBefore}
        a.fs-6.m-1(href="#trust")
          b= t.pressNoteLink
        | #{t.pressNoteAfter}
      p.text-center.fs-6.mb-4= t.pressShare

    include ../layout/inc_footer
    include ../layout/inc_scripts
