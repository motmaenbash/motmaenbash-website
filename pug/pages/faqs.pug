extends ../layout/base.pug
include ../layout/inc_mixins.pug

block variables
  - var t = faqs
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

mixin manifest-code
  .code-box.bg-light.border.rounded.p-3.mt-2
    pre.mb-0
      code(dir="ltr")
        | &lt;!-- Remove permissions automatically added by Firebase and Google Play Services --&gt;
        br
        | &lt;uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" /&gt;
        br
        | &lt;uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" /&gt;
        br
        | &lt;uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" /&gt;
        br
        | &lt;uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" tools:node="remove" /&gt;

mixin faq-blocks(parts)
  each part in parts
    case part.type
      when "text"
        | #{part.text}
      when "p"
        p(class=part.class)= part.text
      when "br"
        br
      when "h6"
        h6= part.text
      when "hr"
        hr
      when "ul"
        ul(class=part.class === undefined ? "list-unstyled" : part.class)
          each item in part.items
            li
              if part.icon
                i(class=part.icon)
              if item.before
                |  #{item.before}
                span.text-success
                  i(class=item.icon)
                | #{item.after}
              else if item.text
                |  #{item.text}
                if item.manifest
                  +manifest-code
              else
                |  #{item}
      when "alert"
        .alert(class=part.class)
          if part.icon
            i(class=part.icon)
            | 
          if part.strong
            strong #{part.strong}
            | 
          | #{part.text}
      when "buttons"
        each button in part.items
          a.btn.btn-sm.btn-outline-primary.mt-2(href=button.href class=button.class target=button.blank ? "_blank" : false)
            if button.icon
              i(class=button.icon)
            |  #{button.label}
      when "split"
        .row(class=part.rowClass)
          div(class=part.mainCol || "col-md-8")
            +faq-blocks(part.main)
          div(class=part.sideCol || "col-md-4")
            +faq-blocks(part.side)
      when "panel"
        .card.bg-light
          .card-body.text-center
            if part.title
              h5= part.title
            +faq-blocks(part.blocks)
      when "cards"
        .row(class=part.rowClass)
          each card in part.items
            .col-md-6
              .card.border-secondary.mb-3
                .card-header.bg-secondary.text-white= card.title
                .card-body
                  +faq-blocks(card.blocks)
      when "sidecards"
        each card in part.items
          .card.bg-light.mb-3
            .card-body
              h6
                if card.icon
                  i(class=card.icon)
                  | 
                | #{card.title}
              ul.list-check
                each line in card.items
                  li= line

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    h1.text-center.mb-3= t.heading
    .row.justify-content-center
      .col-12
        .d-flex.flex-wrap.gap-2.mb-5
          each link in t.links
            a.btn.btn-blue(href=link.href)= link.label

        - var accordionSeq = 0
        #faqAccordion.accordion
          each section in t.sections
            +accordion-header(section.id, section.icon, section.title)
              if section.badge
                span.badge.bg-info.fs-6.text-white.ms-2= section.badge
            each item in section.items
              +accordion-item(item.icon, item.title, item.badge)
                +faq-blocks(item.blocks)

  include ../layout/inc_section_donate
