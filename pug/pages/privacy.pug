extends ../layout/base.pug

block variables
  - var t = privacy
  - var title = t.title
  - var description = t.description
  - var keywords = t.keywords
  - var url = t.url
  - var lang = t.lang
  - var locale = t.locale
  - var alternateUrl = t.alternateUrl
  - var alternateLang = t.alternateLang

block content
  section.container.my-2(class=t.sectionClass || false dir=t.contentDir || false)
    .d-flex.justify-content-end.flex-wrap.gap-2.mb-4
      each language in siteLanguages
        if language.code !== lang && pagesByLang[language.code].indexOf("privacy") !== -1
          a.btn.btn-outline-secondary.btn-sm(href=pageHref(language) lang=language.code)= language.label

    h1.text-center.mb-4= t.heading

    .row
      div
        p.lead.text-center= t.lead

        .card.mt-4
          .card-body
            h2.card-title= t.collectionTitle
            ul.list-unstyled
              each item in t.collection
                li= item

            hr

            each paragraph in t.afterCollection
              p.card-text= paragraph

        .card.mt-4
          .card-body
            h2.card-title= t.analyticsTitle
            p.card-text
              | #{t.analyticsIntro}
              ul
                each item in t.analytics
                  li= item
            each note in t.analyticsNotes
              p.card-text= note
            .code-box.bg-light.border.rounded.p-3.mt-2
              pre.mb-0
                code(dir="ltr")
                  | &lt;!-- Remove permissions automatically added by Firebase and Google Play Services --&gt;
                  br
                  | &lt;uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" /&gt;
                  br
                  | &lt;uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" /&gt;
                  br
                  | &lt;uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" /&gt;
                  br
                  | &lt;uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" tools:node="remove" /&gt;

        .card.mt-4
          .card-body
            h2.card-title= t.moreTitle
            p.card-text #{t.moreBefore} #[a(href=t.moreHref lang=t.moreLang || false) #{t.moreLink}] #{t.moreAfter}
