include inc_lang

nav.navbar.navbar-expand-lg
  .container

    |
    |
    a.navbar-brand(href=nav.home)= nav.brand
    button.navbar-toggler(
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    )
      span.navbar-toggler-icon
    .collapse.navbar-collapse#navbarNav
      ul.navbar-nav.ms-auto
        li.nav-item
          a.nav-link(href=nav.prefix + "/donate.html")
            i.fas.fa-heart.fa-beat
            |  #{nav.donate}
        li.nav-item
          a.nav-link(
            href=nav.prefix + "/faqs.html"
            title=nav.faqsTitle
          )
            i.fas.fa-circle-question
            |  #{nav.faqs}
        li.nav-item.dropdown#downloadMenu
          a.nav-link.dropdown-toggle(
            href="#"
            role="button"
            data-bs-toggle="dropdown"
          )
            i.fas.fa-download
            |  #{nav.download}
          ul.dropdown-menu
            |
            | <!-- Android App -->
            li
              h6.dropdown-header= nav.android
            li
              a.dropdown-item(
                href="https://play.google.com/store/apps/details?id=nu.milad.motmaenbash"
                target="_blank"
              )
                | #{nav.play}
            li
              a.dropdown-item(
                href="https://cafebazaar.ir/app/nu.milad.motmaenbash"
                target="_blank"
              )
                | #{nav.bazaar}
                //- span.badge.bg-info.text-white.ms-2 به زودی
            li
              a.dropdown-item(
                href="https://myket.ir/app/nu.milad.motmaenbash?utm_source=search-ads-gift&utm_medium=cpc"
                target="_blank"
              )
                | #{nav.myket}
            li
              hr.dropdown-divider
            |
            | <!-- Browser Extensions -->
            li
              h6.dropdown-header= nav.extension
            li
              a.dropdown-item(
                href="https://chrome.google.com/webstore/detail/motmaenbash-مطمئن-باش/efhpmpdbeaganelnekhbffjphahncbgn"
                target="_blank"
              ) #{nav.chrome}
            li
              a.dropdown-item(
                href="https://addons.mozilla.org/en-US/firefox/addon/motmaenbash-مطمئن-باش/"
                target="_blank"
              ) #{nav.firefox}
            li
              a.dropdown-item(
                href="https://chrome.google.com/webstore/detail/motmaenbash-مطمئن-باش/efhpmpdbeaganelnekhbffjphahncbgn"
                target="_blank"
              ) #{nav.yandex}
        li.nav-item
          a.nav-link(
            href=nav.prefix + "/git.html"
            title=nav.githubTitle
          )
            i.fab.fa-github
            |  #{nav.github}
        li.nav-item.dropdown
          a.nav-link.dropdown-toggle(
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            title=nav.language
          )
            i.fas.fa-language
            |  #{currentLanguageLabel || nav.language}
          ul.dropdown-menu
            each language in siteLanguages
              if pagesByLang[language.code].indexOf(pageId) !== -1
                li
                  a.dropdown-item(
                    href=pageHref(language)
                    lang=language.code
                    class=language.code === lang ? "active" : false
                    aria-current=language.code === lang ? "page" : false
                  )= language.label
