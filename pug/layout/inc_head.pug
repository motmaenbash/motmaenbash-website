-
  var siteUrl = "https://motmaenbash.ir"
  var siteName = "مطمئن باش"
  var shareImage = siteUrl + "/images/shield-bg.png"
  var pageLang = typeof lang === "undefined" ? "fa" : lang
  var pageLocale = typeof locale === "undefined" ? (pageLang === "en" ? "en_US" : "fa_IR") : locale
  var pageRobots = typeof robots === "undefined" ? "index, follow" : robots
  var pageKeywords = typeof keywords === "undefined" ? "" : keywords
  var inLanguage = pageLang === "en" ? "en" : "fa-IR"
  var graph = [
    {
      "@type": "Organization",
      "@id": siteUrl + "/#organization",
      "name": siteName,
      "alternateName": "MotmaenBash",
      "url": siteUrl,
      "logo": shareImage,
      "email": "hello@motmaenbash.ir",
      "sameAs": [
        "https://github.com/motmaenbash"
      ]
    },
    {
      "@type": "WebSite",
      "@id": siteUrl + "/#website",
      "url": siteUrl,
      "name": siteName,
      "alternateName": "MotmaenBash",
      "inLanguage": "fa-IR",
      "publisher": { "@id": siteUrl + "/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": url + "#webpage",
      "url": url,
      "name": title,
      "description": description,
      "inLanguage": inLanguage,
      "isPartOf": { "@id": siteUrl + "/#website" },
      "about": { "@id": siteUrl + "/#organization" }
    }
  ]
  if (typeof includeSoftware !== "undefined" && includeSoftware)
    graph.push(
      {
        "@type": "SoftwareApplication",
        "name": "مطمئن باش برای اندروید",
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Android",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "IRR" },
        "downloadUrl": "https://play.google.com/store/apps/details?id=nu.milad.motmaenbash",
        "installUrl": siteUrl + "/#android-app",
        "url": siteUrl,
        "image": shareImage,
        "description": description,
        "isAccessibleForFree": true,
        "author": { "@id": siteUrl + "/#organization" }
      },
      {
        "@type": "SoftwareApplication",
        "name": "افزونه مرورگر مطمئن باش",
        "applicationCategory": "SecurityApplication",
        "operatingSystem": "Chrome, Firefox",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "IRR" },
        "installUrl": siteUrl + "/#download",
        "url": siteUrl,
        "image": shareImage,
        "description": description,
        "isAccessibleForFree": true,
        "author": { "@id": siteUrl + "/#organization" }
      }
    )
  var structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }, null, 2)

title=title
meta(charset="UTF-8")
meta(name="viewport" content="width=device-width, initial-scale=1.0")
meta(http-equiv="X-UA-Compatible" content="ie=edge")
meta(name="theme-color" content="#1261A7")

// SEO Meta Tags
meta(name="description" content=description)
if pageKeywords
  meta(name="keywords" content=pageKeywords)
meta(name="robots" content=pageRobots)
meta(name="author" content="Milad Nouri")

// Open Graph Tags
meta(property="og:site_name" content=siteName)
meta(property="og:type" content="website")
meta(property="og:url" content=url)
meta(property="og:title" content=title)
meta(property="og:description" content=description)
meta(property="og:image" content=shareImage)
meta(property="og:image:alt" content=siteName)
meta(property="og:image:width" content="1024")
meta(property="og:image:height" content="1024")
meta(property="og:locale" content=pageLocale)
if typeof alternateUrl !== "undefined"
  meta(property="og:locale:alternate" content=(pageLang === "en" ? "fa_IR" : "en_US"))

// Twitter Meta Tags
meta(name="twitter:card" content="summary_large_image")
meta(name="twitter:url" content=url)
meta(name="twitter:title" content=title)
meta(name="twitter:description" content=description)
meta(name="twitter:image" content=shareImage)
meta(name="twitter:image:alt" content=siteName)

// Other required meta tags
link(rel="icon" type="image/png" href=shareImage)
link(rel="canonical" href=url)
if typeof alternateUrl !== "undefined"
  link(rel="alternate" hreflang=alternateLang href=alternateUrl)
  link(rel="alternate" hreflang=(pageLang === "en" ? "en" : "fa") href=url)
  link(rel="alternate" hreflang="x-default" href=(pageLang === "en" ? alternateUrl : url))
link(rel="stylesheet" href="css/bootstrap.rtl.min.css?v=v5.3.3")
link(rel="stylesheet" href="css/style.css?v=1.0.9")

script(type="application/ld+json")!= structuredData
